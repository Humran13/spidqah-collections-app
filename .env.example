# Copy this file to .env and fill in real values. Never commit .env.

# Flask
FLASK_APP=wsgi:app
FLASK_ENV=production
SECRET_KEY=change-this-to-a-long-random-string

# Database (used by the web container; docker-compose sets host=db automatically)
DATABASE_URL=postgresql+psycopg2://spidqah:spidqah@db:5432/spidqah
POSTGRES_USER=spidqah
POSTGRES_PASSWORD=change-this-strong-password
POSTGRES_DB=spidqah

# Host port the app is exposed on. It is bound to 127.0.0.1 by default
# (not reachable from outside this machine) - put a reverse proxy in
# front of it for external access. Override WEB_BIND only if you
# deliberately want a different bind address.
WEB_PORT=8000
# WEB_BIND=127.0.0.1

# Organization / accounting defaults
ORG_NAME=SPIDQAH
DEFAULT_GO_LIVE_DATE=2026-09-18

# Session cookie security - set to true once served over HTTPS
SESSION_COOKIE_SECURE=false

# First Admin user, created automatically on first container start.
# Change the password immediately after first login, then you may remove
# these from your real .env if you prefer.
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=change-this-strong-password

RATELIMIT_ENABLED=true

# CloudPanel persistent storage (set automatically by scripts/deploy-vps.sh
# when it detects a matching CloudPanel website for the domain you give it;
# leave these blank for local development - plain Docker-managed named
# volumes are used instead). When set, HOST_POSTGRES_DIR and
# HOST_UPLOADS_DIR must be absolute host paths under the CloudPanel site
# user's home directory so they are covered by CloudPanel/rclone backups.
# CLOUDPANEL_DOMAIN=col.example.com
# CLOUDPANEL_USER=example-col
# HOST_POSTGRES_DIR=/home/example-col/spidqah-data/postgres
# HOST_UPLOADS_DIR=/home/example-col/spidqah-data/uploads
# HOST_BACKUPS_DIR=/home/example-col/spidqah-data/backups
